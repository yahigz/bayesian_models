    type discrete [ 2 ] { no, yes };
}
variable Diagnosis {
    type discrete [ 2 ] { anomaly, nominal };
}
variable HAL {
    type discrete [ 3 ] { normal, offline, sabotage };
}
variable HAL_Switch {
    type discrete [ 2 ] { off, on };
}
variable Life_Support {
    type discrete [ 3 ] { critical, degraded, stable };
}
variable Manoeuvre {
    type discrete [ 2 ] { evasive, none };
}
variable Meteor_Shower {
    type discrete [ 2 ] { no, yes };
}
variable O2_Generator {
    type discrete [ 2 ] { faulty, ok };
}
variable O2_Level {
    type discrete [ 2 ] { low, normal };
}
variable Porthole {
    type discrete [ 2 ] { clear, danger };
}
variable System_Age {
    type discrete [ 2 ] { new, old };
}
variable Temperature {
    type discrete [ 3 ] { cold, hot, normal };
}
variable Thermostat {
    type discrete [ 2 ] { faulty, ok };
}
