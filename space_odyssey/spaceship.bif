network unknown {
}
variable AI_Test {
    type discrete [ 2 ] { fail, pass };
}
variable Alert_System {
    type discrete [ 2 ] { silent, warning };
}
variable Alien_Attack {
    type discrete [ 2 ] { no, yes };
}
